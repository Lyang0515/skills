# 统一换行符：该仓库需同步到 Linux 服务器执行脚本，统一使用 LF
* text=auto eol=lf

# 明确文本类型
*.md   text eol=lf
*.sh   text eol=lf
*.py   text eol=lf
*.c    text eol=lf
*.qml  text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.txt  text eol=lf

# 二进制文件不做转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
